# Copia este archivo como .env.local y completa los valores de
# Firebase: consola → Configuración del proyecto → Tus apps → ConstGua (web).
# Estos valores son públicos (van en el JavaScript de la app); la seguridad
# está en firestore.rules. Nunca pongas aquí llaves de cuentas de servicio.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# true para conectar con los emuladores locales (npm run emulators).
VITE_USE_EMULATORS=false
